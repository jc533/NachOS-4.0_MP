{
  "configurations": [
    {
      "name": "windows-gcc-x64",
      "intelliSenseMode": "windows-gcc-x64",
      "includePath": [
        "${workspaceFolder}/**"
      ],
      "compilerPath": "gcc",
      "defines": [
        "FILESYS_STUB",
        "NO_HALT_STAT",
        "RDATA",
        "SIM_FIX",
        "CHANGED",
        "LINUX",
        "x86"
      ],
      "configurationProvider": "ms-vscode.makefile-tools",
      "cStandard": "${default}",
      "cppStandard": "${default}"
    }
  ],
  "version": 4
}